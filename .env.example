# --- YouTube (Owner-OAuth) ---
# Desktop-OAuth-Client aus der Google Cloud Console (YouTube Data API v3 aktiviert).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Loopback-Redirect fuer den Desktop-Flow; Port frei waehlbar.
YOUTUBE_REDIRECT_URI=http://localhost:53682/oauth2callback

# Kanal des Owners (UC... ). Optional: wird sonst aus dem OAuth-Token (mine=true) ermittelt.
YOUTUBE_CHANNEL_ID=

# Members-only Playlist, die als Quelle der Wahrheit fuer Inner Circle dient (PL... ).
INNER_CIRCLE_PLAYLIST_ID=
# Wohin das OAuth-Token lokal gespeichert wird (gitignored).
YOUTUBE_TOKEN_PATH=.youtube-token.json

# --- Anthropic (P3 Decision-Layer) ---
ANTHROPIC_API_KEY=
# Optional: Modell-Override fuer die Vorschlaege. Opus = staerkstes Modell; der
# einmalige Back-Catalog-Batch rechtfertigt die Opus-Stufe.
ANTHROPIC_MODEL=claude-opus-4-8
