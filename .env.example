# --- YouTube (Owner-OAuth) ---
# Desktop-OAuth-Client aus der Google Cloud Console (YouTube Data API v3 aktiviert).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Loopback-Redirect fuer den Desktop-Flow; Port frei waehlbar.
YOUTUBE_REDIRECT_URI=http://localhost:53682/oauth2callback

# Kanal des Owners (UC... ). Optional: wird sonst aus dem OAuth-Token (mine=true) ermittelt.
YOUTUBE_CHANNEL_ID=

# Members-only Playlist, die als Quelle der Wahrheit fuer Inner Circle dient (PL... ).
INNER_CIRCLE_PLAYLIST_ID=
# Wohin das OAuth-Token lokal gespeichert wird (gitignored).
YOUTUBE_TOKEN_PATH=.youtube-token.json

# --- Anthropic (P3 Decision-Layer) ---
ANTHROPIC_API_KEY=
# Optional: Modell-Override fuer die Vorschlaege. Opus = staerkstes Modell; der
# einmalige Back-Catalog-Batch rechtfertigt die Opus-Stufe.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Privates State-Repo (Sicherung des unwiederbringlichen Zustands) ---
# Lokaler Pfad zum Klon von dimensionwithin/thumbnail-agent-state (PRIVAT).
# scripts/backup-state.cjs kopiert dorthin nach jedem Wochenlauf, committet und
# pusht. Nicht gesetzt = Backup wird sauber uebersprungen, der Wochenlauf laeuft
# normal weiter. Beispiel (relativ zum Projektordner): STATE_REPO_DIR=../thumbnail-agent-state
STATE_REPO_DIR=

# --- Thumbnail-Compositor (lokaler Python-Dienst) ---
# Ordner der TradingView-Rohscreenshots, aus dem "Neuestes Chart laden" liest.
# ABSOLUT angeben: ein relativer Pfad wird gegen den Projektordner aufgeloest.
THUMBNAIL_SOURCE_DIR=
# Zielordner der fertigen Thumbnails.
THUMBNAIL_EXPORT_DIR=

# --- Uebergabe der Shorts-Linie (DH: src/upload/uebergabe-leser.js) ---
# Wurzel des Renderordners, in dem die Aufnahmeordner der Shorts-Linie liegen.
# Gelesen wird ausschliesslich <SHORTS_RENDER_WURZEL>/<aufnahme>/uebergabe.json;
# alles andere steht IN dieser Datei. Es wird kein Ordner abgesucht und kein
# Dateiname erraten -- neben den guten Shorts liegen Ordner mit fehlerhaften
# Fassungen, die am Inhalt nicht zu unterscheiden sind.
# ABSOLUT angeben. Der Platzhalter unten traegt bewusst keinen
# Laufwerksbuchstaben; der Freigabe-Check meldet einen echten Pfad zu Recht.
SHORTS_RENDER_WURZEL=/Pfad/zum/Renderlaufwerk/Shorts Rendered

# --- Freigabeoberflaeche der Shorts-Linie (DJ: src/upload/freigabe-server.js) ---
# Port des lokalen Freigabe-Dienstes. Er bindet ausschliesslich an 127.0.0.1 und
# ist von aussen nicht erreichbar; jede Anfrage muss ausserdem das Sitzungstoken
# fuehren, das bei jedem Start neu erzeugt und auf der Konsole ausgegeben wird.
# Leer oder nicht gesetzt = 8791 (8787 ist auf diesem Rechner belegt). Ein belegter Port wird beim Start benannt,
# nicht nur gemeldet; --port= schlaegt diesen Wert.
# Der Dienst liest die Uebergabedatei NIE selbst -- er ruft den Leser oben auf
# und arbeitet mit dessen --json-Ausgabe. Die Wurzel nimmt er darum aus
# SHORTS_RENDER_WURZEL; ein eigener Pfadschluessel waere ein zweiter Weg zu
# denselben Dateien.
SHORTS_FREIGABE_PORT=8791

# --- Aufnahmen der Longform-Linie (Compositor: Kandidatenliste fuer das Feld
# "aufnahme" im Beipackzettel) ---
# Wurzel des Ordners, in dem die Aufnahmeordner liegen (Name JJJJ-MM-TT HH-MM-SS).
# Der Compositor zeigt daraus die Aufnahmen des Kalendertags als Kandidaten; ist
# der Tag leer, weitet er auf die Nachbartage und sagt es. Gewaehlt wird immer
# von Hand -- die Liste schlaegt vor, sie entscheidet nicht.
# Nicht gesetzt = keine Kandidatenliste; das Aufnahmefeld bleibt eine Handeingabe.
# ABSOLUT angeben. Der Platzhalter unten traegt bewusst keinen
# Laufwerksbuchstaben; der Freigabe-Check meldet einen echten Pfad zu Recht.
AUFNAHME_WURZEL=/Pfad/zum/Renderlaufwerk/MatrixMarketAutoEdit

# --- Render der Longform-Linie (EK: src/upload/longform-arbeiter.js) ---
# Wurzel des Ordners, in dem der fertige Schnitt <aufnahme>.matrix-cut.mp4 liegt
# (VERTRAG-longform 3.2). Der Pfad wird aus dieser Wurzel und dem Aufnahmenamen
# zusammengebaut und in der Vorschau woertlich angezeigt; abgebrochene
# Renderversuche (.partial) und die Handarbeit (.upload.mp4) werden nie genommen.
# Nicht gesetzt = der Longform-Weg ist nicht startbar. Der Arbeiter endet mit 2
# und nennt den Schluessel; der Freigabedienst im Longform-Modus nimmt seine
# Sperre, bekommt den 2er, bricht mit 1 ab und gibt die Sperre wieder frei
# (EL, 04.09.2026, an diesem Rechner gemessen).
# ABSOLUT angeben. Der Platzhalter unten traegt bewusst keinen
# Laufwerksbuchstaben; der Freigabe-Check meldet einen echten Pfad zu Recht.
LONGFORM_RENDER_WURZEL=/Pfad/zum/Renderlaufwerk/Longform Rendered
